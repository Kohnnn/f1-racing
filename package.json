{
  "name": "f1-racing",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm run sync:models && npm run generate:sample && npm run refresh:showcase:replay && npm run dev -w @f1-racing/web",
    "build": "npm run check:featured && npm run build:briefs && node tools/build-static.mjs",
    "build:pages": "npm run check:featured && npm run build:briefs && npm run next:build -w @f1-racing/web",
    "build:briefs": "node pipeline/export/src/build-evidence-briefs.mjs",
    "generate:sample": "node pipeline/export/src/generate-sample-data.mjs",
    "sync:models": "node pipeline/export/src/sync-web-models.mjs",
    "split:replay": "node pipeline/export/src/split-replay-packs.mjs",
    "api:dev": "python -m uvicorn backend.main:app --reload --host 127.0.0.1 --port 8080",
    "api:start": "python -m uvicorn backend.main:app --host 0.0.0.0 --port 8080",
    "check:data": "node pipeline/export/src/generate-sample-data.mjs --check",
    "test:featured": "node pipeline/export/src/refresh-seasons-index.test.mjs",
    "test:briefs": "node pipeline/export/src/build-evidence-briefs.test.mjs",
    "test:session-pack": "node pipeline/export/src/build-openf1-session-pack.test.mjs",
    "test:openf1-client": "node pipeline/ingest/src/openf1-client.test.mjs",
    "test:openf1-regeneration": "node tools/regenerate-openf1-candidate.test.mjs",
    "check:briefs": "node pipeline/export/src/build-evidence-briefs.mjs --check",
    "test:pit-cycles": "node packages/telemetry-utils/src/pit-cycle.test.mjs",
    "test:replay-director": "node tools/replay-director.test.mjs",
    "test:learning-trail": "node tools/learning-trail.test.mjs",
    "check:dashboard": "node tools/dashboard-journey.test.mjs",
    "test:dashboard:browser": "node tools/dashboard-journey.test.mjs --browser",
    "test:replay-chunks": "node tools/replay-chunks.test.mjs",
    "test:split-replay": "node pipeline/export/src/split-replay-packs.test.mjs",
    "test:backend": "python -m unittest backend.test_path_validation backend.test_replay_chunks",
    "check:replay-keyboard": "node tools/replay-keyboard-probe.mjs",
    "test:replay-keyboard": "node tools/replay-keyboard-probe.mjs --browser",
    "check:featured": "npm run test:featured && node pipeline/export/src/refresh-seasons-index.mjs --check",
    "init:openfoam:local": "node pipeline/openfoam/src/init-openfoam-local.mjs",
    "build:openfoam:overlay": "node pipeline/openfoam/src/build-openfoam-overlay-pack.mjs",
    "apply:openfoam:inputs": "node pipeline/openfoam/src/apply-openfoam-user-inputs.mjs",
    "check:openfoam:ready": "node pipeline/openfoam/src/check-openfoam-readiness.mjs",
    "inspect:glb:mcl39": "node pipeline/openfoam/src/inspect-glb-mesh.mjs --file glb_model/f1_2025_mclaren_mcl39.glb",
    "cloudflare:whoami": "wrangler whoami",
    "ingest:openf1:2025": "node pipeline/ingest/src/ingest-openf1-2025-season.mjs",
    "build:openf1:session": "node pipeline/export/src/build-openf1-session-pack.mjs",
    "build:silhouettes": "node pipeline/export/src/build-silhouette-from-svg.mjs",
    "build:openf1:replay": "node pipeline/export/src/build-openf1-replay-pack.mjs",
    "refresh:showcase:replay": "node pipeline/export/src/build-openf1-session-pack.mjs --grandPrixSlug abu-dhabi-grand-prix --sessionSlug race && node pipeline/export/src/build-openf1-replay-pack.mjs --grandPrixSlug abu-dhabi-grand-prix --sessionSlug race && node pipeline/export/src/refresh-seasons-index.mjs && node pipeline/export/src/split-replay-packs.mjs",
    "build:fastf1:replay": "python pipeline/fastf1/build-fastf1-replay-pack.py",
    "build:fastf1:replay:2025": "node pipeline/fastf1/rebuild-fastf1-season.mjs --year 2025",
    "build:fastf1:replay:local": "pip install -r pipeline/fastf1/requirements.txt && python pipeline/fastf1/build-fastf1-replay-pack.py",
    "worker:dev": "npm run dev -w @f1-racing/metadata-api",
    "worker:check": "npm run check -w @f1-racing/metadata-api",
    "worker:deploy": "npm run deploy -w @f1-racing/metadata-api",
    "typecheck": "npm run typecheck -w @f1-racing/web",
    "quality:source": "npm run typecheck && npm run test:briefs && npm run check:briefs && npm run test:session-pack && npm run test:openf1-client && npm run test:openf1-regeneration && npm run test:replay-director && npm run test:learning-trail && npm run check:dashboard && npm run test:replay-chunks && npm run test:split-replay && npm run test:backend && npm run check:modelview && npm run check:replay-keyboard",
    "check:modelview": "node tools/modelview-accessibility.test.mjs",
    "test:modelview:browser": "node tools/modelview-accessibility.test.mjs --browser",
    "quality": "npm run quality:source && npm run check:data",
    "smoke:static": "node tools/smoke-static.mjs",
    "test:release-data": "node tools/release-data.test.mjs",
    "test:release-data:e2e": "node tools/release-data.test.mjs --e2e",
    "release:artifact": "node tools/release-artifact.mjs",
    "release:regenerate:openf1": "node tools/regenerate-openf1-candidate.mjs",
    "release:data": "node tools/release-data.mjs",
    "release:browser": "node tools/release-gates.mjs browser",
    "release:security": "node tools/release-gates.mjs security",
    "release:parity": "node tools/release-gates.mjs parity",
    "test:release-gates": "node tools/release-gates.test.mjs",
    "build:wind-profiles": "node pipeline/export/src/build-wind-profiles.mjs",
    "probe:svg-art": "node pipeline/export/probe-svg-art.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "draco3dgltf": "^1.5.7",
    "playwright": "^1.51.1",
    "wrangler": "^4.39.0"
  },
  "engines": {
    "node": ">=20"
  }
}
